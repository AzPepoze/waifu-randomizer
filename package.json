{
	"name": "waifu-randomizer",
	"version": "1.0.0",
	"description": "A web application that fetches and displays random 'waifu' images from an external API, featuring SFW/NSFW categories, loading indicators, and a fullscreen image viewer with zoom and pan.",
	"type": "module",
	"imports": {
		"#lib/*": [
			"./src/lib/*",
			"./src/lib/*.ts",
			"./src/lib/*.svelte"
		]
	},
	"private": true,
	"license": "ISC",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"sync": "svelte-kit sync",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "bun run typecheck && bun run lint && bun run format:check"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"sass": "^1.105.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"viewerjs": "^1.15.2"
	}
}
